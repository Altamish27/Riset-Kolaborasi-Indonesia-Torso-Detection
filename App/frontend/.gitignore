# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
**/build/

# Gradle wrapper (if you want to regenerate)
# Uncomment the next two lines if you don't want to track the wrapper jar
# gradle/wrapper/gradle-wrapper.jar
# gradlew
# gradlew.bat

# Local configuration file (sdk path, etc)
local.properties

# Android Studio
.idea/
*.iml
*.iws
*.ipr
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetSelector.xml

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild/
.cxx/

# Google Services (if using Firebase, uncomment)
# google-services.json

# OS-specific files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Crash log files
crash-*.txt

# Kotlin
*.kotlin_module

# Proguard
proguard/

